# Server
NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://deliverix:deliverix@localhost:5432/deliverix?schema=public

# Auth (min 32 chars; use strong values in prod via secrets manager)
JWT_ACCESS_SECRET=replace-with-a-32+char-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-32+char-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
MFA_ISSUER=Deliverix

# Argon2id parameters (OWASP/AJWG recommended values)
ARGON2_MEMORY_KIB=19456
ARGON2_TIME=2
ARGON2_PARALLELISM=1

# CORS: comma-separated trusted origins
CORS_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=info
LOG_PRETTY=false

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# SMTP (Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@deliverix.local

# Cloudinary (proof/object storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=